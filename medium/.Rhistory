title = "Interactive Data Explorer",
sidebar = sidebar(
width = 300,
selectInput("dataset_choice", "Choose Dataset:",
choices = c("GT Cars", "E-commerce Example", "Upload CSV")),
conditionalPanel(
condition = "input.dataset_choice == 'Upload CSV'",
fileInput("datafile", "Upload CSV File", accept = c(".csv"))
),
checkboxInput("use_duckdb", "Enable DuckDB", value = TRUE)
),
# Explicitly set the height and overflow here
div(style = "height: 90vh; overflow: hidden;",
gwalkrOutput("explorer", height = "100%")
)
)
# Main display area for GWalkR
card(
full_screen = TRUE,
gwalkrOutput("explorer", height = "800px")
)
)
library(GWalkR)
library(shiny)
library(bslib)
library(readr)
# Load example datasets
data("gtcars", package = "gt")
# Creating a dummy ecommerce-style dataset for the example
ecommerce_data <- data.frame(
Date = seq(as.Date("2023-01-01"), by = "day", length.out = 100),
Quantity_Sold = rpois(100, lambda = 50),
Category = sample(c("Electronics", "Clothing", "Home"), 100, replace = TRUE)
)
ui <- page_sidebar(
title = "Interactive Data Explorer",
sidebar = sidebar(
width = 300,
# 1. Dataset Selection
selectInput("dataset_choice", "Choose Dataset:",
choices = c("Upload CSV", "GT Cars", "E-commerce Example")),
# 2. File Input (only shown if 'Upload CSV' is selected)
conditionalPanel(
condition = "input.dataset_choice == 'Upload CSV'",
fileInput("datafile", "Upload CSV File", accept = c(".csv"))
),
# 3. DuckDB Toggle
checkboxInput("use_duckdb", "Enable DuckDB (Kernel Computation)", value = TRUE),
hr(),
helpText("Use the 'Visualization' tab on the right to drag and drop variables.")
),
# Main display area for GWalkR
card(
full_screen = TRUE,
gwalkrOutput("explorer", height = "800px")
)
)
server <- function(input, output, session) {
# Reactive expression to determine which data to use
selected_data <- reactive({
choice <- input$dataset_choice
if (choice == "GT Cars") {
return(gtcars)
} else if (choice == "E-commerce Example") {
return(ecommerce_data)
} else {
# Handle File Upload
req(input$datafile)
return(read.csv(input$datafile$datapath, stringsAsFactors = FALSE))
}
})
# Render GWalkR visualization
output$explorer <- renderGwalkr({
# Ensure data is available before rendering
df <- selected_data()
req(df)
gwalkr(
data = df,
lang = "en",
dark = "light",
kernelComputation = input$use_duckdb # Reactive toggle
)
})
}
shinyApp(ui, server)
GWalkR::gwalkr(gt::gtcars)
library(GWalkR)
library(shiny)
library(bslib)
library(gt) # Ensure gtcars is available
ui <- page_sidebar(
title = "Interactive Data Explorer",
sidebar = sidebar(
width = 300,
selectInput("dataset_choice", "Choose Dataset:",
choices = c("GT Cars", "Upload CSV")),
conditionalPanel(
condition = "input.dataset_choice == 'Upload CSV'",
fileInput("datafile", "Upload CSV File", accept = c(".csv"))
),
checkboxInput("use_duckdb", "Enable DuckDB", value = TRUE)
),
# FIX: We use a custom div to ensure the widget has space to breathe
# '95vh' means 95% of the browser window height
div(style = "height: 95vh; padding: 10px;",
gwalkrOutput("explorer", height = "100%")
)
)
server <- function(input, output, session) {
selected_data <- reactive({
if (input$dataset_choice == "GT Cars") {
return(gt::gtcars)
} else {
req(input$datafile)
return(read.csv(input$datafile$datapath, stringsAsFactors = FALSE))
}
})
output$explorer <- renderGwalkr({
df <- selected_data()
req(df)
# We wrap this in isolate so the toggle doesn't
# completely wipe your work every time you click it
gwalkr(
data = df,
lang = "en",
dark = "light",
kernelComputation = input$use_duckdb
)
})
}
shinyApp(ui, server)
library(GWalkR)
