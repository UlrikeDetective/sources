library(GWalkR)
library(shiny)
library(gt)
# Load example data
data(gtcars)
ui <- fluidPage(
titlePanel("Interactive Data Explorer"),
# Using a standard fluidRow/column layout instead of bslib page_sidebar
sidebarLayout(
sidebarPanel(
width = 3,
selectInput("dataset_choice", "Choose Dataset:",
choices = c("GT Cars", "Upload CSV")),
conditionalPanel(
condition = "input.dataset_choice == 'Upload CSV'",
fileInput("datafile", "Upload CSV File", accept = c(".csv"))
),
checkboxInput("use_duckdb", "Enable DuckDB (Kernel)", value = TRUE),
hr(),
helpText("If the 'Visualization' tab is missing, try opening in a full browser window.")
),
mainPanel(
width = 9,
# Forcing a minimum height so the header/tabs are visible
gwalkrOutput("mygraph", height = "800px")
)
)
)
server <- function(input, output, session) {
# Reactive data selection
selected_data <- reactive({
if (input$dataset_choice == "GT Cars") {
return(gtcars)
} else {
req(input$datafile)
# Use read.csv for local uploads
read.csv(input$datafile$datapath, stringsAsFactors = FALSE)
}
})
output$mygraph <- renderGwalkr({
df <- selected_data()
req(df)
gwalkr(
data = df,
kernelComputation = input$use_duckdb
)
})
}
