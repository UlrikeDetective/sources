# Load example datasets
data("gtcars", package = "gt")
# Creating a dummy ecommerce-style dataset for the example
ecommerce_data <- data.frame(
Date = seq(as.Date("2023-01-01"), by = "day", length.out = 100),
Quantity_Sold = rpois(100, lambda = 50),
