} else {
# Handle File Upload
req(input$datafile)
return(read.csv(input$datafile$datapath, stringsAsFactors = FALSE))
}
})
# Render GWalkR visualization
output$explorer <- renderGwalkr({
# Ensure data is available before rendering
df <- selected_data()
req(df)
gwalkr(
data = df,
lang = "en",
dark = "light",
kernelComputation = input$use_duckdb # Reactive toggle
)
})
}
shinyApp(ui, server)
