library(GWalkR)
library(shiny)
library(gt)
# Load example data
data(gtcars)
ui <- fluidPage(
titlePanel("Interactive Data Explorer"),
# Using a standard fluidRow/column layout instead of bslib page_sidebar
sidebarLayout(
sidebarPanel(
width = 3,
selectInput("dataset_choice", "Choose Dataset:",
choices = c("GT Cars", "Upload CSV")),
conditionalPanel(
condition = "input.dataset_choice == 'Upload CSV'",
fileInput("datafile", "Upload CSV File", accept = c(".csv"))
),
checkboxInput("use_duckdb", "Enable DuckDB (Kernel)", value = TRUE),
hr(),
helpText("If the 'Visualization' tab is missing, try opening in a full browser window.")
),
mainPanel(
width = 9,
# Forcing a minimum height so the header/tabs are visible
gwalkrOutput("mygraph", height = "800px")
)
)
)
server <- function(input, output, session) {
# Reactive data selection
selected_data <- reactive({
if (input$dataset_choice == "GT Cars") {
return(gtcars)
} else {
req(input$datafile)
# Use read.csv for local uploads
read.csv(input$datafile$datapath, stringsAsFactors = FALSE)
}
})
output$mygraph <- renderGwalkr({
df <- selected_data()
req(df)
gwalkr(
data = df,
kernelComputation = input$use_duckdb
)
})
}
shinyApp(ui, server)
library(GWalkR)
library(shiny)
library(gt)
# 1. Prepare the data
data(gtcars)
ui <- fluidPage(
titlePanel("Interactive Data Explorer"),
sidebarLayout(
sidebarPanel(
width = 3,
selectInput("dataset_choice", "Choose Dataset:",
choices = c("GT Cars", "Upload CSV")),
# This only shows up if the user selects 'Upload CSV'
conditionalPanel(
condition = "input.dataset_choice == 'Upload CSV'",
fileInput("datafile", "Upload CSV File", accept = c(".csv"))
),
checkboxInput("use_duckdb", "Enable DuckDB", value = TRUE),
hr(),
helpText("The 'Visualization' and 'Data' tabs are icons at the top-left of the chart area.")
),
mainPanel(
width = 9,
# Force a large height so the toolbar isn't cut off
gwalkrOutput("mygraph", height = "800px")
)
)
)
server <- function(input, output, session) {
# 2. Improved Reactive Logic
selected_data <- reactive({
if (input$dataset_choice == "GT Cars") {
return(gtcars)
} else {
# ONLY require the file if 'Upload CSV' is selected
req(input$datafile)
read.csv(input$datafile$datapath, stringsAsFactors = FALSE)
}
})
output$mygraph <- renderGwalkr({
# Get the data (will default to gtcars on startup)
df <- selected_data()
# 3. Render the widget
gwalkr(
data = df,
kernelComputation = input$use_duckdb
)
})
}
shinyApp(ui, server)
