server <- function(input, output, session) {
selected_data <- reactive({
if (input$dataset_choice == "GT Cars") {
return(gt::gtcars)
} else {
req(input$datafile)
return(read.csv(input$datafile$datapath, stringsAsFactors = FALSE))
}
})
output$explorer <- renderGwalkr({
df <- selected_data()
req(df)
# We wrap this in isolate so the toggle doesn't
# completely wipe your work every time you click it
gwalkr(
data = df,
lang = "en",
dark = "light",
kernelComputation = input$use_duckdb
)
})
}
